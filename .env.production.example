# ==============================================================================
# NoteFlow AI • Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secret keys to source control.
# Values should be configured in Render & Vercel environment settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configured in Vercel Dashboard)
# ------------------------------------------------------------------------------
# Current Live Deployment:
VITE_APP_URL=https://noteflow-ai-cc3p.vercel.app
VITE_API_URL=https://noteflow-ai-3nal.onrender.com/api

# Future Custom Domain Migration:
# VITE_APP_URL=https://app.noteflow.ai
# VITE_API_URL=https://api.noteflow.ai/api

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Configured in Render Web Service Settings)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Web Application Origin & CORS Configuration
# Current Live Deployment:
FRONTEND_URL=https://noteflow-ai-cc3p.vercel.app
CORS_ORIGIN=https://noteflow-ai-cc3p.vercel.app,https://app.noteflow.ai

# Future Custom Domain Migration:
# FRONTEND_URL=https://app.noteflow.ai
# CORS_ORIGIN=https://app.noteflow.ai

# Cryptography & Session Protection
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Managed Persistence (PostgreSQL & Redis)
DATABASE_URL=postgresql://noteflow_user:password@db.noteflow.internal:5432/noteflow_prod?sslmode=require
REDIS_URL=rediss://default:password@redis.noteflow.internal:6379

# Google Cloud OAuth 2.0 Client Credentials
# Current Live Deployment Callback:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://noteflow-ai-3nal.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://noteflow-ai-3nal.onrender.com/api/auth/google/callback

# Future Custom Domain Callback:
# GOOGLE_CALLBACK_URL=https://api.noteflow.ai/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://api.noteflow.ai/api/auth/google/callback

# Ingress Speech-to-Text & AI Synthesis API Keys
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
