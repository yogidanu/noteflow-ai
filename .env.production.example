# ==========================================
# NoteFlow AI • Meet Record Production Environment Template
# Note: Values must be injected via AWS Secrets Manager or CI/CD
# ==========================================

NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://app.noteflow.ai

# Cryptography (32-byte Hex String)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Session Secret (64-byte Hex String)
SESSION_SECRET=

# Managed Database & Redis
DATABASE_URL=postgresql://noteflow_user:password@db.noteflow.internal:5432/noteflow_prod?sslmode=require
REDIS_URL=rediss://default:password@redis.noteflow.internal:6379

# Google Cloud Console OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.noteflow.ai/api/auth/google/callback

# Speech-to-Text & Diarization Provider (Deepgram Nova-2 / Whisper)
DEEPGRAM_API_KEY=

# NoteFlow AI Grounded Synthesizer LLM Key (Claude 3.5 Sonnet / Vertex)
ANTHROPIC_API_KEY=
