# ==============================================================================
# NoteFlow AI • Local Development Environment Template (.env)
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Frontend (Vite) Local Environment
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Backend (Express) Local Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Cryptography (Default development keys)
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
SESSION_SECRET=generate-a-long-random-string

# Google OAuth 2.0 (Development)
GOOGLE_CLIENT_ID=noteflow-google-client-id-sample.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional Local Database / Redis
# DATABASE_URL=postgresql://noteflow_user:password@localhost:5432/noteflow_dev
# REDIS_URL=redis://localhost:6379

# Speech-to-Text & Diarization
DEEPGRAM_API_KEY=your-deepgram-api-key
